{
  "uid": "public-safety-live",
  "title": "Public Safety Alerts: Live",
  "tags": [
    "streaming",
    "public-safety"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active warnings",
      "description": "NWS warnings in effect now (not cancelled, not expired, not tests).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-safety-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "public-safety-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select count(*) as warnings from v_active_incidents where event like '%Warning'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "People under an active warning",
      "description": "Population of every county covered by at least one active warning, each county counted once (Census ACS 5-year estimates).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-safety-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "public-safety-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select coalesce(sum(population), 0) as people from v_people_under_warnings"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Earthquakes M2.5+ (24h)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-safety-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "public-safety-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select count(*) as quakes from quakes where magnitude >= 2.5 and event_type = 'earthquake' and status <> 'deleted' and origin_time > now() - interval '24 hours'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Data freshness",
      "description": "Seconds since the newest record was ingested. Over 5 minutes usually means the producer or a feed is stuck.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-safety-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "public-safety-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select extract(epoch from now() - max(ingested_at)) as seconds from ( select max(ingested_at) as ingested_at from alert_messages union all select max(ingested_at) from quake_versions) as newest"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Alerts",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "New alerts by severity (per 15 min, by issue time)",
      "description": "Bucketed by event time (when NWS issued the alert), not by when it arrived.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-safety-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "public-safety-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select date_bin('15 minutes', sent, timestamptz '2000-01-01') as time, severity as metric, count(*) as value from alert_messages where message_type = 'Alert' and $__timeFilter(sent) group by 1, 2 order by 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "People under warnings by state (top 10)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-safety-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "public-safety-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select state_name, population from v_people_under_warnings order by population desc limit 10"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^population$/"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Active hazards affecting the most people",
      "description": "unmatched_counties: county codes with no Census match (for example Connecticut, whose counties were replaced by planning regions in 2022).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-safety-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "public-safety-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select event, severity, area_desc as area, population, counties, unmatched_counties, expires, message_count as messages from v_active_incidents order by population desc, expires limit 25"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "population"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Earthquakes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "geomap",
      "title": "Earthquakes, last 24 hours",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-safety-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 14,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "public-safety-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select latitude, longitude, magnitude, place, origin_time from quakes where status <> 'deleted' and origin_time > now() - interval '24 hours'"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 30,
          "lon": -110,
          "zoom": 2
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Earthquakes",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "field": "magnitude",
                  "fixed": 5,
                  "min": 2,
                  "max": 18
                },
                "color": {
                  "field": "magnitude"
                },
                "opacity": 0.6,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-YlRd"
          },
          "min": 0,
          "max": 7
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Earthquakes revised after first publication",
      "description": "USGS revises magnitude and location as more stations report. First vs latest.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-safety-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 23,
        "w": 10,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "public-safety-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select place, origin_time, first_magnitude, latest_magnitude, magnitude_change, version_count as versions, status from v_quake_revisions order by origin_time desc limit 20"
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Pipeline health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Consumer lag (messages behind)",
      "description": "How far the processor is behind the end of each topic.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-safety-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "public-safety-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select measured_at as time, topic as metric, sum(lag) as value from consumer_lag where $__timeFilter(measured_at) group by 1, 2 order by 1"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Latency p95 (seconds)",
      "description": "Source delay (issued by NWS until our producer read it) vs our own pipeline delay.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-safety-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "public-safety-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select bucket as time, p95_source_to_ingest_seconds as \"NWS issued to ingested\", p95_ingest_to_store_seconds as \"Ingested to stored\" from v_alert_latency where $__timeFilter(bucket) order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Processed per 5 minutes",
      "description": "Duplicates are expected after restarts (at-least-once delivery) and are skipped.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-safety-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "public-safety-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select date_bin('5 minutes', batch_at, timestamptz '2000-01-01') as time, sum(new_alert_messages) as \"New alert messages\", sum(new_quake_versions) as \"New quake versions\", sum(duplicates) as \"Duplicates skipped\", sum(errors) as \"Errors\" from processor_batches where $__timeFilter(batch_at) group by 1 order by 1"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
