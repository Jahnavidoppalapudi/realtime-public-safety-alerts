# Copy to .env (make env does this), then edit. Never commit .env.

# api.weather.gov requires an app name and contact email in the User-Agent
CONTACT_USER_AGENT="public-safety-alerts (your-email@example.com)"

# How often to poll each feed, in seconds
POLL_SECONDS=60

# PostgreSQL (application owner) and the read-only login Grafana uses
POSTGRES_PASSWORD=app
GRAFANA_DB_PASSWORD=grafana
GRAFANA_ADMIN_PASSWORD=admin

# Census population data: ACS 5-year vintage. An API key is optional for this volume.
CENSUS_VINTAGE=2023
CENSUS_API_KEY=
